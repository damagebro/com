*cat rtl.f
>>>
$RTL_DIR/impl/impl_define.sv
$RTL_DIR/StLib/common/com_define.sv

-f $RTL_DIR/impl/impl.f
-f $RTL_DIR/common/com_common.f
-f $RTL_DIR/emi/com_emi.f
-f $RTL_DIR/csr/com_csr.f
-f $RTL_DIR/img/com_img.f
-f $RTL_DIR/IP1.f
-f $RTL_DIR/IP2.f
>>>


# define file -------------------------------------------------------------------
1. rtl/impl/impl_define.sv,  set all define;
2. rtl/common/com_define.sv, include some define function;

# create a ip content -------------------------------------------------------------------
1. mkdir rtl
2. cd rtl; git clone <com_repo>;
3. mkdir impl; cp com/impl_template/* impl/* -rf;
4. mkdir IP1; start develop IP1;